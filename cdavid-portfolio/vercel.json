{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/cdavid-portfolio/browser",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api?path=/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
